BoxData["\"\"",StandardForm],
"Print",ExpressionUUID -> "b0b85617-6a60-4611-89ab-d2dc9f845915"],Cell[
BoxData["\"What this is. A coherence demonstration. The framework asserts\"",
StandardForm],"Print",ExpressionUUID -> "5735f5e3-f34b-4796-b959-c9195791ba4b"],Cell[
BoxData[
"\"in Paper 1 sec. 4.3 that 'both are instances of the same\"",StandardForm],"Print",
ExpressionUUID -> "f6862798-386f-47d7-b084-dd60757e699a"],Cell[
BoxData["\"abstract structure: a sub-symmetry made available by a closed\"",
StandardForm],"Print",ExpressionUUID -> "5a393650-5778-4dbe-9b19-2d12d200891c"],Cell[
BoxData[
"\"generative field at its boundary.' That claim is encoded in\"",StandardForm],"Print",
ExpressionUUID -> "a1c66b5c-95c3-419d-8b08-6323408e1d29"],Cell[
BoxData["\"the comma's IrreducibilityKind field. The algebra confirms\"",
StandardForm],"Print",ExpressionUUID -> "b047edbe-99b9-42ff-9318-1438ece62ced"],Cell[
BoxData[
"\"the claim is internally consistent and machine-checkable: when\"",StandardForm],
"Print",ExpressionUUID -> "2ae0788e-bbad-4bc2-9e39-f98114ac84b7"],Cell[
BoxData["\"operationalized, the framework's stated cross-domain shape\"",
StandardForm],"Print",ExpressionUUID -> "fef957b0-83ea-494d-83a6-c7bb14e77a1a"],Cell[
BoxData[
"\"does fire on the Tymoczko-Cutting pair on three independent\"",StandardForm],"Print",
ExpressionUUID -> "1f842b1c-1e59-4d8e-83d3-9c842ad23e7e"],Cell[
BoxData["\"grounds the schema can articulate.\"",
StandardForm],"Print",ExpressionUUID -> "5240b2c6-f5c5-4ca8-b537-f493a4353966"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "c0a1de53-b651-4f76-b4a2-fcb9e0b73040"],Cell[
BoxData[
"\"What this is not. An empirical proof of cross-domain comma\"",StandardForm],"Print",
ExpressionUUID -> "0cf6a360-15fd-4c2f-a9ee-89febbd94e65"],Cell[
BoxData["\"equivalence. Paper 1 sec. 4.3 itself names this as 'the open\"",
StandardForm],"Print",ExpressionUUID -> "aa669704-8bdb-45f6-8484-11e7cf6469e9"],Cell[
BoxData[
"\"empirical question the proxy feature program is designed to\"",StandardForm],"Print",
ExpressionUUID -> "3bf5abfc-b09b-4209-bc55-514038b57413"],Cell[
BoxData["\"test.' Paper 3 sec. 8.1 cites Cubitt et al. 2015 (spectral gap\"",
StandardForm],"Print",ExpressionUUID -> "551731c8-a5ad-413c-be39-4c3d3900d7a2"],Cell[
BoxData[
"\"undecidability) as one independently established cross-domain\"",StandardForm],
"Print",ExpressionUUID -> "298bb081-645f-4875-9ca9-9055cd70bf50"],Cell[
BoxData["\"formal equivalence; the general homology claim is otherwise\"",
StandardForm],"Print",ExpressionUUID -> "fcf2d454-599e-4451-aff7-c2934136eb29"],Cell[
BoxData[
"\"structural argument awaiting RG-style or category-theoretic\"",StandardForm],"Print",
ExpressionUUID -> "9863e3b2-49cf-4821-9dfc-d1014cacec12"],Cell[
BoxData["\"formalization. The 0.92 confidence reports schema coherence,\"",
StandardForm],"Print",ExpressionUUID -> "0c138516-91b7-4cfe-a583-ae72c33c4988"],Cell[
BoxData[
"\"not empirical validation.\"",StandardForm],"Print",ExpressionUUID -> "eb7e5f75-782e-48e8-861b-ecd142e1cd09"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "aad1de38-9fd5-4b0f-b178-0661e6e6be1d"],Cell[
BoxData[
"\"Independent corroboration of the two cores themselves:\"",StandardForm],"Print",
ExpressionUUID -> "be5af580-ec22-4878-9b07-47aa8fd11233"],Cell[

StandardForm],"Print",ExpressionUUID -> "0af28cd6-202d-42bf-80ce-8b8956836d63"],Cell[
BoxData[
"\"on the basis the script can articulate:\"",StandardForm],"Print",ExpressionUUID -> "ed326728-8b7f-43d0-bc8e-ca4903eaf5a6"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "bfeaca59-6d91-470e-9532-ff00f44770e1"],Cell[

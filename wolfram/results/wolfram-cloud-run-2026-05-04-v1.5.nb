BoxData["\"the framework's articulated cross-domain claim from Paper 1\"",
StandardForm],"Print",ExpressionUUID -> "eaec7c9a-5602-4710-8d39-684098342e92"],Cell[
BoxData[
"\"sec. 4.3. NKS's CommaRice has IrreducibilityKind\"",StandardForm],"Print",ExpressionUUID -> "56544ddb-9b57-48e6-a019-dec8629751cc"],Cell[
BoxData[
"\"'BehaviouralPredicateUndecidability' - a different abstract\"",StandardForm],"Print",
ExpressionUUID -> "c69cc37b-c231-4932-8645-3d5b39331e9a"],Cell[
BoxData["\"structural shape, which the algebra correctly identifies as\"",
StandardForm],"Print",ExpressionUUID -> "bf307da5-776c-4bfd-b0d8-431cc50cd7b4"],Cell[
BoxData[
"\"NOT comma-shape-equivalent to the other two.\"",StandardForm],"Print",ExpressionUUID -> "1856d67a-c471-4529-aa6e-5040ea7f60b8"],Cell[
BoxData[
"\"\"",StandardForm],"Print",ExpressionUUID -> "f013ed67-7a6f-42eb-a086-59719439768f"],Cell[
BoxData[
"\"Honest reading: the panel demonstrates that the algebra\"",StandardForm],"Print",
ExpressionUUID -> "3e603ff9-a6a4-4d20-80ce-a2c3195822f5"],Cell[
BoxData["\"discriminates on comma-shape, and that the high-confidence\"",
StandardForm],"Print",ExpressionUUID -> "e0820a91-4926-4bd7-9a37-a469ba3d5a8a"],Cell[
BoxData[
"\"centerpiece result is specific to the framework's claim, not\"",StandardForm],
"Print",ExpressionUUID -> "72bc4fbc-9108-496e-9200-d08de4557585"],Cell[
BoxData["\"a uniform output. It does not establish the cross-domain\"",
StandardForm],"Print",ExpressionUUID -> "f055f974-bf3f-4449-8b3b-3ba9c87930e6"],Cell[
BoxData[
"\"homology empirically; that remains the framework's open\"",StandardForm],"Print",
ExpressionUUID -> "4825313f-61f8-4261-82fb-e30e543754b9"],Cell[
BoxData["\"question. It does establish that the framework's claim is\"",
StandardForm],"Print",ExpressionUUID -> "350019fd-8a0c-4293-8de9-f2ae55c18f1f"],Cell[
BoxData[
"\"machine-checkable and that its computational signature is\"",StandardForm],"Print",
ExpressionUUID -> "e7b7b2c4-6e0e-4044-ba8f-7dedab199c16"],Cell[
BoxData["\"the centerpiece's heat, not the panel's edge counts.\"",
StandardForm],"Print",ExpressionUUID -> "66b51671-f8fa-4d9c-858f-9d3728c94597"]},

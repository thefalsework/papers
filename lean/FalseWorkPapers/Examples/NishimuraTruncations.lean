  | ng,  g   => nng
  | ng,  ng  => top
  | ng,  nng => nng
  | ng,  gng => top
  | ng,  x6  => top
  | ng,  top => top
  | nng, bot => ng
  | nng, g   => gng
  | nng, ng  => ng
  | nng, nng => top

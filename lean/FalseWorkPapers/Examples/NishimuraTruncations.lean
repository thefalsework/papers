instance : HImp Z8 := ⟨himpFun⟩
instance : Compl Z8 := ⟨fun a => himpFun a bot⟩

instance : PartialOrder Z8 where
  le := (· ≤ ·)
  lt := (· < ·)
  le_refl       := fun a       => by cases a <;> decide
  le_trans      := fun a b c   => by cases a <;> cases b <;> cases c <;> decide
  le_antisymm   := fun a b     => by cases a <;> cases b <;> decide
  lt_iff_le_not_ge := fun _ _  => Iff.rfl

instance : SemilatticeInf Z8 where
  inf           := (· ⊓ ·)
  inf_le_left   := fun a b     => by cases a <;> cases b <;> decide
  inf_le_right  := fun a b     => by cases a <;> cases b <;> decide
  le_inf        := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : SemilatticeSup Z8 where
  sup           := (· ⊔ ·)
  le_sup_left   := fun a b     => by cases a <;> cases b <;> decide
  le_sup_right  := fun a b     => by cases a <;> cases b <;> decide
  sup_le        := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : Lattice Z8 where
  __ := (inferInstance : SemilatticeInf Z8)
  __ := (inferInstance : SemilatticeSup Z8)

instance : DistribLattice Z8 where
  le_sup_inf    := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : BoundedOrder Z8 where
  top := top
  bot := bot
  le_top a := by cases a <;> decide
  bot_le a := by cases a <;> decide

theorem le_himp_iff_z8 (a b c : Z8) : a ≤ b ⇨ c ↔ a ⊓ b ≤ c := by
  cases a <;> cases b <;> cases c <;> decide

instance heytingAlgebra : HeytingAlgebra Z8 :=
  HeytingAlgebra.ofHImp himpFun le_himp_iff_z8

/-- `Z_8` certification: the named elements are the Nishimura terms in `g`.
Here `x_5 = ¬¬g ⇨ g` is a genuinely new rung (unlike at `n = 6, 7`), and the
Prop-10 coincidence moves up: `x_7 = x_5 ⇨ (g ⊔ ¬g) = x_6`. -/
theorem rn_terms :
    (g : Z8)ᶜ = ng ∧ ((g : Z8)ᶜ)ᶜ = nng ∧ (g : Z8) ⊔ gᶜ = gng ∧
    (g : Z8) ⊓ gᶜ = ⊥ ∧ ((nng : Z8) ⇨ g) = x5 ∧ (nng : Z8) ⊔ gng = x6 ∧
    ((x5 : Z8) ⇨ gng) = x6 ∧ (x5 : Z8) ⊔ x6 = ⊤ := by decide

/-- `Z_8` is one-generated: every element is a Heyting term in `g`. -/
theorem one_generated :
    ∀ y : Z8, y = g ∨ y = gᶜ ∨ y = gᶜᶜ ∨ y = g ⊔ gᶜ ∨ y = g ⊓ gᶜ ∨
      y = gᶜᶜ ⇨ g ∨ y = gᶜᶜ ⊔ (g ⊔ gᶜ) ∨ y = ⊤ := by decide

/-- The generator is non-regular: `¬¬g ≠ g`. -/
theorem g_non_regular : ((g : Z8)ᶜ)ᶜ ≠ g := by decide

/-- The four cells at the generator kernel, inhabited by the same four
Nishimura terms as at every other truncation. -/
theorem witness :
    IsLatticeInfrastructure (g : Z8) g ∧
    IsLatticeRefusal        (g : Z8) ng ∧
    IsLatticeExploitation   (g : Z8) nng ∧
    IsLatticeDistribution   (g : Z8) gng := by decide

/-- **Unique forced kernel.**  In `Z_8` the generator `g` is the *only*
element at which all four cells are inhabited. -/
theorem kernel_unique : ∀ a : Z8, AllFourCellsInhabited a ↔ a = g := by decide

end Z8

/-! ## `Div12` *is* `Z_6`: the music lattice is the 6-element truncation

The music anchor's substrate `Div12` (divisor lattice of 12 = subgroup
lattice of `ℤ/12`) is itself one-generated — by the **tritone** — with the
same Nishimura term structure.  By Citkin's uniqueness theorem **[C]**,
`Div12 ≅ Z_6`, the unique 6-element one-generated Heyting algebra.  The
music substrate is the cardinality-6 truncation of the free Heyting algebra
on one generator; the tritone is the free generator; and the music witness
cells are the Nishimura terms:

| Term      | `Div12`  | pitch-class object          |
|-----------|----------|------------------------------|
| `g ⊓ ¬g`  | `one`    | trivial `{0}`                |
| `¬g`      | `three`  | augmented triad `⟨4⟩`       |
| `g`       | `two`    | tritone `⟨6⟩`               |
| `¬¬g`     | `four`   | diminished seventh `⟨3⟩`    |
| `g ⊔ ¬g`  | `six`    | whole-tone hexachord `⟨2⟩`  |
| `x_6`     | `twelve` | full chromatic `ℤ/12`       |
-/

namespace Div12

/-- **`Div12` is one-generated by the tritone**: every element of the music
lattice is an explicit Heyting term in `two = ⟨6⟩`.  With
`Fintype.card Div12 = 6` and Citkin's uniqueness theorem [C], this
identifies the music lattice as `Z_6` — the cardinality-6 truncation of the
free Heyting algebra on one generator. -/
theorem one_generated_by_tritone :
    ∀ y : Div12, y = two ∨ y = twoᶜ ∨ y = twoᶜᶜ ∨ y = two ⊔ twoᶜ ∨
      y = two ⊓ twoᶜ ∨ y = twoᶜᶜ ⊔ (two ⊔ twoᶜ) := by decide

/-- The Nishimura terms in the tritone generator land on the named
pitch-class objects, including the Prop-10 coincidence
`x_5 = ¬¬g ⇨ g = g ⊔ ¬g` characteristic of `n = 6`. -/
theorem rn_terms :
    (two : Div12)ᶜ = three ∧ ((two : Div12)ᶜ)ᶜ = four ∧
    (two : Div12) ⊔ twoᶜ = six ∧ (two : Div12) ⊓ twoᶜ = one ∧
    ((four : Div12) ⇨ two) = six ∧ (four : Div12) ⊔ six = twelve := by decide

/-- **Unique forced kernel, upgraded to [K].**  The tritone is the *only*
element of `Div12` at which all four cells are inhabited.  (Previously
verified computationally in Wolfram — tag [C]; this is the kernel-checked
version.) -/
theorem kernel_unique : ∀ a : Div12, AllFourCellsInhabited a ↔ a = two := by
  decide

end Div12

/-! ## The stability bundle: pre-registered outcome (A) -/

/-- **Forced-kernel stability across the Rieger–Nishimura truncations
(pre-registered outcome A).**  Across the canonical finite truncations
`Z_n` of the free Heyting algebra on one generator:

* `n = 5`: no four-cell kernel exists (the partition needs cardinality ≥ 6);
* `n = 6` (= `Div12`, the music lattice): unique kernel = the generator
  (= the tritone);
* `n = 7`: unique kernel = the generator;
* `n = 8`: unique kernel = the generator.

The forced kernel is **unique and truncation-stable**: it is the free
generator at every checked truncation, with the four cells inhabited by the
same Nishimura terms `g, ¬g, ¬¬g, g ⊔ ¬g`.  The extension to all `n ≥ 6`
(and to the infinite Rieger–Nishimura lattice) is the all-n kernel law,
`nishimura_kernel_unique` in `NishimuraKernelLaw.lean`. -/
theorem rn_truncation_outcome_A :
    (∀ a : Z5, ¬ AllFourCellsInhabited a) ∧
    (∀ a : Div12, AllFourCellsInhabited a ↔ a = Div12.two) ∧
    (∀ a : Z7, AllFourCellsInhabited a ↔ a = Z7.g) ∧
    (∀ a : Z8, AllFourCellsInhabited a ↔ a = Z8.g) :=
  ⟨Z5.no_kernel, Div12.kernel_unique, Z7.kernel_unique, Z8.kernel_unique⟩

end Examples


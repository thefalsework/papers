  ⟨{bot, g, ng, nng, gng, x6, top}, by intro x; cases x <;> decide⟩

/-- Order: `⊥`; atoms `g, ¬g`; `¬¬g` covers `g`; `g⊔¬g` covers `g, ¬g`;
`x_6 = ¬¬g ⊔ (g⊔¬g)` covers both; `⊤`. -/
def leb : Z7 → Z7 → Bool
  | bot, _    => true
  | g,   g    => true
  | g,   nng  => true
  | g,   gng  => true
  | g,   x6   => true
  | g,   top  => true
  | ng,  ng   => true
  | ng,  gng  => true
  | ng,  x6   => true
  | ng,  top  => true
  | nng, nng  => true
  | nng, x6   => true
  | nng, top  => true
  | gng, gng  => true
  | gng, x6   => true
  | gng, top  => true
  | x6,  x6   => true
  | x6,  top  => true
  | top, top  => true
  | _,   _    => false

instance : LE Z7 := ⟨fun a b => leb a b = true⟩
instance : LT Z7 := ⟨fun a b => a ≤ b ∧ ¬ b ≤ a⟩

instance decLE : ∀ a b : Z7, Decidable (a ≤ b) := fun a b => by
  show Decidable (leb a b = true); exact decEq _ _

instance : DecidableLE Z7 := decLE

def meet : Z7 → Z7 → Z7
  | bot, _   => bot
  | _,   bot => bot
  | top, y   => y
  | x,   top => x
  | g,   g   => g
  | g,   ng  => bot
  | g,   nng => g
  | g,   gng => g
  | g,   x6  => g
  | ng,  g   => bot
  | ng,  ng  => ng
  | ng,  nng => bot
  | ng,  gng => ng
  | ng,  x6  => ng
  | nng, g   => g
  | nng, ng  => bot
  | nng, nng => nng
  | nng, gng => g
  | nng, x6  => nng
  | gng, g   => g
  | gng, ng  => ng
  | gng, nng => g
  | gng, gng => gng
  | gng, x6  => gng

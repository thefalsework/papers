  | ng,  x6  => x6
  | nng, g   => nng
  | nng, ng  => x6
  | nng, nng => nng
  | nng, gng => x6
  | nng, x6  => x6
  | gng, g   => gng
  | gng, ng  => gng
  | gng, nng => x6

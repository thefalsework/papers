import Mathlib.Order.Heyting.Basic
import Mathlib.Data.Fintype.Basic
import FalseWorkPapers.Lattice.FourPositionLattice
import FalseWorkPapers.Examples.DivisorLattice12

namespace FalseWork.Lattice

/-! ## Decidability for the Layer-L cell predicates

The four predicates of `FourPositionLattice` are `def`s, so `decide` cannot
see through them without explicit `Decidable` instances.  Provide them for
any Heyting algebra with decidable `≤` and `=`. -/

section DecInstances

variable {H : Type*} [HeytingAlgebra H]

instance (a x : H) [Decidable (x ≤ a)] :
    Decidable (IsLatticeInfrastructure a x) :=
  decidable_of_iff (x ≤ a) Iff.rfl

instance (a x : H) [Decidable (x ≤ aᶜ)] :
    Decidable (IsLatticeRefusal a x) :=
  decidable_of_iff (x ≤ aᶜ) Iff.rfl

instance (a x : H) [Decidable (x ≤ aᶜᶜ)] [Decidable (x ≤ a)] :
    Decidable (IsLatticeExploitation a x) :=
  decidable_of_iff (x ≤ aᶜᶜ ∧ ¬ x ≤ a) Iff.rfl

instance (a x : H) [DecidableEq H] :
    Decidable (IsLatticeDistribution a x) :=
  decidable_of_iff ((x ⊓ a ≠ ⊥) ∧ (x ⊓ aᶜ ≠ ⊥)) Iff.rfl

end DecInstances

/-- **All four Layer-L cells are simultaneously inhabited at kernel `a`.**
This is the non-degeneracy condition of the four-position partition: the
partition theorem (`lattice_four_position_partition`) always holds, but only
kernels satisfying this predicate make all four cells non-vacuous. -/
def AllFourCellsInhabited {H : Type*} [HeytingAlgebra H] (a : H) : Prop :=
  (∃ x, x ≠ ⊥ ∧ IsLatticeInfrastructure a x) ∧
  (∃ x, IsLatticeDistribution a x) ∧
  (∃ x, IsLatticeExploitation a x) ∧
  (∃ x, x ≠ ⊥ ∧ IsLatticeRefusal a x)

instance {H : Type*} [HeytingAlgebra H] [Fintype H] [DecidableEq H]
    [DecidableLE H] (a : H) : Decidable (AllFourCellsInhabited a) :=
  decidable_of_iff
    ((∃ x, x ≠ ⊥ ∧ x ≤ a) ∧
     (∃ x, (x ⊓ a ≠ ⊥) ∧ (x ⊓ aᶜ ≠ ⊥)) ∧
     (∃ x, x ≤ aᶜᶜ ∧ ¬ x ≤ a) ∧
     (∃ x, x ≠ ⊥ ∧ x ≤ aᶜ))
    Iff.rfl

namespace Examples

/-! ## `Z_5`: the largest truncation with NO four-cell kernel

`Z_5 = {⊥, g, ¬g, g ⊔ ¬g, ⊤}`: bottom, two atoms, their join, top.  The
generator `g` is *regular* (`¬¬g = g`), and the dense element `g ⊔ ¬g` has
`⊥` complement, so no element passes both non-degeneracy requirements. -/

inductive Z5 : Type
  | bot | g | ng | gng | top
  deriving DecidableEq, Repr

namespace Z5

instance : Fintype Z5 :=
  ⟨{bot, g, ng, gng, top}, by intro x; cases x <;> decide⟩

/-- Order: `⊥ < {g, ¬g} < g⊔¬g < ⊤`. -/
def leb : Z5 → Z5 → Bool
  | bot, _    => true
  | g,   g    => true
  | g,   gng  => true
  | g,   top  => true
  | ng,  ng   => true
  | ng,  gng  => true
  | ng,  top  => true
  | gng, gng  => true
  | gng, top  => true
  | top, top  => true
  | _,   _    => false

instance : LE Z5 := ⟨fun a b => leb a b = true⟩
instance : LT Z5 := ⟨fun a b => a ≤ b ∧ ¬ b ≤ a⟩

instance decLE : ∀ a b : Z5, Decidable (a ≤ b) := fun a b => by
  show Decidable (leb a b = true); exact decEq _ _

instance : DecidableLE Z5 := decLE

def meet : Z5 → Z5 → Z5
  | bot, _   => bot
  | _,   bot => bot
  | top, y   => y
  | x,   top => x
  | g,   g   => g
  | g,   ng  => bot
  | g,   gng => g
  | ng,  g   => bot
  | ng,  ng  => ng
  | ng,  gng => ng
  | gng, g   => g
  | gng, ng  => ng
  | gng, gng => gng

def join : Z5 → Z5 → Z5
  | bot, y   => y
  | x,   bot => x
  | top, _   => top
  | _,   top => top
  | g,   g   => g
  | g,   ng  => gng
  | g,   gng => gng
  | ng,  g   => gng
  | ng,  ng  => ng
  | ng,  gng => gng
  | gng, g   => gng
  | gng, ng  => gng
  | gng, gng => gng

instance : Min Z5 := ⟨meet⟩
instance : Max Z5 := ⟨join⟩
instance : Top Z5 := ⟨top⟩
instance : Bot Z5 := ⟨bot⟩

def himpFun : Z5 → Z5 → Z5
  | bot, _   => top
  | top, y   => y
  | g,   bot => ng
  | g,   g   => top
  | g,   ng  => ng
  | g,   gng => top
  | g,   top => top
  | ng,  bot => g
  | ng,  g   => g
  | ng,  ng  => top
  | ng,  gng => top
  | ng,  top => top
  | gng, bot => bot
  | gng, g   => g
  | gng, ng  => ng
  | gng, gng => top
  | gng, top => top

instance : HImp Z5 := ⟨himpFun⟩
instance : Compl Z5 := ⟨fun a => himpFun a bot⟩

instance : PartialOrder Z5 where
  le := (· ≤ ·)
  lt := (· < ·)
  le_refl       := fun a       => by cases a <;> decide
  le_trans      := fun a b c   => by cases a <;> cases b <;> cases c <;> decide
  le_antisymm   := fun a b     => by cases a <;> cases b <;> decide
  lt_iff_le_not_ge := fun _ _  => Iff.rfl

instance : SemilatticeInf Z5 where
  inf           := (· ⊓ ·)
  inf_le_left   := fun a b     => by cases a <;> cases b <;> decide
  inf_le_right  := fun a b     => by cases a <;> cases b <;> decide
  le_inf        := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : SemilatticeSup Z5 where
  sup           := (· ⊔ ·)
  le_sup_left   := fun a b     => by cases a <;> cases b <;> decide
  le_sup_right  := fun a b     => by cases a <;> cases b <;> decide
  sup_le        := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : Lattice Z5 where
  __ := (inferInstance : SemilatticeInf Z5)
  __ := (inferInstance : SemilatticeSup Z5)

instance : DistribLattice Z5 where
  le_sup_inf    := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : BoundedOrder Z5 where
  top := top
  bot := bot
  le_top a := by cases a <;> decide
  bot_le a := by cases a <;> decide

theorem le_himp_iff_z5 (a b c : Z5) : a ≤ b ⇨ c ↔ a ⊓ b ≤ c := by
  cases a <;> cases b <;> cases c <;> decide

instance heytingAlgebra : HeytingAlgebra Z5 :=
  HeytingAlgebra.ofHImp himpFun le_himp_iff_z5

/-- `Z_5` certification: the named elements are the Nishimura terms in `g`,
and the generator is **regular** (`¬¬g = g`) — which is exactly why no
four-cell kernel can exist here. -/
theorem rn_terms :
    (g : Z5)ᶜ = ng ∧ ((g : Z5)ᶜ)ᶜ = g ∧ (g : Z5) ⊔ gᶜ = gng ∧
    (g : Z5) ⊓ gᶜ = ⊥ := by decide

/-- `Z_5` is one-generated: every element is a Heyting term in `g`. -/
theorem one_generated :
    ∀ y : Z5, y = g ∨ y = gᶜ ∨ y = g ⊔ gᶜ ∨ y = g ⊓ gᶜ ∨ y = ⊤ := by decide

/-- **Negative result (kernel-checked).**  No element of `Z_5` makes all four
cells of the four-position partition simultaneously inhabited.  Below
cardinality 6 the partition is always degenerate.

Prior-art note: since the four-cell condition is equivalent to being an
*ordinary* element (`allFourCellsInhabited_iff`, `NishimuraKernelLaw.lean`),
this is a kernel-checked re-derivation of an observation already in
Citkin 2024 §2.1 ("the algebras `Z_i`, `i ∈ [2,5]`, do not contain any
ordinary elements") — known, not new. -/
theorem no_kernel : ∀ a : Z5, ¬ AllFourCellsInhabited a := by decide

end Z5

/-! ## `Z_7`: seven elements, unique kernel = the generator -/

inductive Z7 : Type
  | bot | g | ng | nng | gng | x6 | top
  deriving DecidableEq, Repr


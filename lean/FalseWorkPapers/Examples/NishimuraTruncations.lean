  inf_le_left   := fun a b     => by cases a <;> cases b <;> decide
  inf_le_right  := fun a b     => by cases a <;> cases b <;> decide
  le_inf        := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : SemilatticeSup Z7 where

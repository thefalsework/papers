instance : Min Z7 := ⟨meet⟩
instance : Max Z7 := ⟨join⟩
instance : Top Z7 := ⟨top⟩
instance : Bot Z7 := ⟨bot⟩

def himpFun : Z7 → Z7 → Z7
  | bot, _   => top
  | top, y   => y
  | g,   bot => ng
  | g,   g   => top
  | g,   ng  => ng
  | g,   nng => top
  | g,   gng => top
  | g,   x6  => top

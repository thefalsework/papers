  sup_le        := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : Lattice Z7 where
  __ := (inferInstance : SemilatticeInf Z7)
  __ := (inferInstance : SemilatticeSup Z7)

instance : DistribLattice Z7 where
  le_sup_inf    := fun a b c   => by cases a <;> cases b <;> cases c <;> decide

instance : BoundedOrder Z7 where
  top := top
  bot := bot
  le_top a := by cases a <;> decide
  bot_le a := by cases a <;> decide

theorem le_himp_iff_z7 (a b c : Z7) : a ≤ b ⇨ c ↔ a ⊓ b ≤ c := by
  cases a <;> cases b <;> cases c <;> decide

instance heytingAlgebra : HeytingAlgebra Z7 :=
  HeytingAlgebra.ofHImp himpFun le_himp_iff_z7

/-- `Z_7` certification: the named elements are the Nishimura terms in `g`,
including the Prop-10 coincidence `x_5 = x_4` (`¬¬g ⇨ g = g ⊔ ¬g`) that is
characteristic of `n = 7`. -/
theorem rn_terms :
    (g : Z7)ᶜ = ng ∧ ((g : Z7)ᶜ)ᶜ = nng ∧ (g : Z7) ⊔ gᶜ = gng ∧
    (g : Z7) ⊓ gᶜ = ⊥ ∧ ((nng : Z7) ⇨ g) = gng ∧ (nng : Z7) ⊔ gng = x6 := by
  decide

/-- `Z_7` is one-generated: every element is a Heyting term in `g`. -/
theorem one_generated :
    ∀ y : Z7, y = g ∨ y = gᶜ ∨ y = gᶜᶜ ∨ y = g ⊔ gᶜ ∨ y = g ⊓ gᶜ ∨
      y = gᶜᶜ ⊔ (g ⊔ gᶜ) ∨ y = ⊤ := by decide

/-- The generator is non-regular: `¬¬g ≠ g` — the double-negation
non-collapse that makes Exploitation inhabitable. -/
theorem g_non_regular : ((g : Z7)ᶜ)ᶜ ≠ g := by decide

/-- The four cells at the generator kernel, inhabited by the four Nishimura
terms: `g` (Infrastructure), `¬g` (Refusal), `¬¬g` (Exploitation),
`g ⊔ ¬g` (Distribution). -/
theorem witness :
    IsLatticeInfrastructure (g : Z7) g ∧
    IsLatticeRefusal        (g : Z7) ng ∧
    IsLatticeExploitation   (g : Z7) nng ∧
    IsLatticeDistribution   (g : Z7) gng := by decide

/-- **Unique forced kernel.**  In `Z_7` the generator `g` is the *only*
element at which all four cells are inhabited. -/
theorem kernel_unique : ∀ a : Z7, AllFourCellsInhabited a ↔ a = g := by decide

end Z7

/-! ## `Z_8`: eight elements, unique kernel = the generator

First truncation where `x_5 = ¬¬g ⇨ g` is a *new* element (the ladder's next
rung), checking stability one step beyond the `Div12`-sized case. -/

inductive Z8 : Type
  | bot | g | ng | nng | gng | x5 | x6 | top
  deriving DecidableEq, Repr

namespace Z8

instance : Fintype Z8 :=
  ⟨{bot, g, ng, nng, gng, x5, x6, top}, by intro x; cases x <;> decide⟩

/-- Order: `⊥`; atoms `g, ¬g`; `¬¬g` covers `g`; `g⊔¬g` covers `g, ¬g`;
`x_5 = ¬¬g ⇨ g` covers `g⊔¬g`; `x_6 = ¬¬g ⊔ (g⊔¬g)` covers `¬¬g, g⊔¬g`;
`⊤` covers `x_5, x_6`. -/
def leb : Z8 → Z8 → Bool
  | bot, _    => true
  | g,   g    => true
  | g,   nng  => true
  | g,   gng  => true
  | g,   x5   => true
  | g,   x6   => true
  | g,   top  => true
  | ng,  ng   => true
  | ng,  gng  => true
  | ng,  x5   => true
  | ng,  x6   => true
  | ng,  top  => true
  | nng, nng  => true
  | nng, x6   => true
  | nng, top  => true
  | gng, gng  => true
  | gng, x5   => true
  | gng, x6   => true
  | gng, top  => true
  | x5,  x5   => true
  | x5,  top  => true
  | x6,  x6   => true
  | x6,  top  => true
  | top, top  => true
  | _,   _    => false

instance : LE Z8 := ⟨fun a b => leb a b = true⟩
instance : LT Z8 := ⟨fun a b => a ≤ b ∧ ¬ b ≤ a⟩

instance decLE : ∀ a b : Z8, Decidable (a ≤ b) := fun a b => by
  show Decidable (leb a b = true); exact decEq _ _

instance : DecidableLE Z8 := decLE


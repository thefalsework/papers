# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor cruft
.vscode/
.idea/
*.swp
*~

# Pandoc / PDF build artifacts
papers/**/*-latest.pdf
papers/**/*.tmp.pdf
*.aux
*.log
*.toc
*.out

# Lean build artifacts
lean/.lake/
lean/build/
lean/lake-packages/

# Local toolchain binaries (tectonic, etc.)
.tools/

# Untracked corpus checkouts (software-study, afp-study)
.scratch_*/
.scratch_*.mjs


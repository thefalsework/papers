# against the SHAs pinned in results-census.json)
software-study/history/crates-2024.json
software-study/history/crates-2026.json

# Temporary files
_*.txt
_p*.txt
*.bak
.commit-msg-tmp
.issue*-body.md

# Node / JS (in case any tooling lands here)
node_modules/
package-lock.json

# Python build artifacts
__pycache__/
*.pyc
